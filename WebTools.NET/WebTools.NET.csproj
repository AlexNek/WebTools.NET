<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>WebTools.NET</RootNamespace>
    <AssemblyName>WebTools.NET</AssemblyName>

    <!-- NuGet metadata -->
    <PackageId>WebTools.NET</PackageId>
    <Title>WebTools.NET</Title>
    <Description>Web tools for .NET applications: web search, browser-based content fetching, and navigation.</Description>
    <Authors>Alex Nek</Authors>
    <PackageTags>web;search;browser;playwright;tools;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Repository metadata -->
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryUrl>https://github.com/AlexNek/WebTools.NET</RepositoryUrl>
    <PackageProjectUrl>https://github.com/AlexNek/WebTools.NET</PackageProjectUrl>

    <!-- Symbols / CI -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WebTools.NET.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebTools.NET.ContentAnalysis\WebTools.NET.ContentAnalysis.csproj"
                      PrivateAssets="all"
                      TreatAsPackageReference="false" />
  </ItemGroup>

  <!-- Include the referenced analysis assembly in this package instead of creating a package dependency. -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>
      $(TargetsForTfmSpecificBuildOutput);IncludeContentAnalysisAssemblyInPackage
    </TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="IncludeContentAnalysisAssemblyInPackage">
    <ItemGroup>
      <BuildOutputInPackage Include="$(TargetDir)WebTools.NET.ContentAnalysis.dll" />
    </ItemGroup>
  </Target>

  <!-- Pack README and icon -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageReference Include="CloakBrowser" Version="0.4.5" />
    <PackageReference Include="AngleSharp" Version="1.5.2" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
  </ItemGroup>

</Project>
